; selfie.cs.uni-salzburg.at

; SMT-LIB formulae generated by /home/envy/selfie/monster for
; RISC-V code obtained from benchmark/functions/absolute.c with
; unbounded execution depth, branching limit of 10000, and merging disabled

(set-option :produce-models true)
(set-option :incremental true)
(set-logic QF_BV)

(declare-fun i0 () (_ BitVec 64)); variable for benchmark/functions/absolute.c: pc==0x10080(~1)
(declare-fun m1 () (_ BitVec 64)); variable for benchmark/functions/absolute.c: pc==0x1020C(~16)
(assert (= m1 i0)); store in benchmark/functions/absolute.c: pc==0x1020C(~16)
(declare-fun b2 () Bool); variable for benchmark/functions/absolute.c: pc==0x10160(~3)
(assert (= b2 (= (ite (bvult m1 (_ bv0 64)) (_ bv1 64) (_ bv0 64)) (_ bv0 64)))); beq in benchmark/functions/absolute.c: pc==0x10160(~3)
(declare-fun p3 () Bool); variable for benchmark/functions/absolute.c: pc==0x10160(~3)
(assert (= p3 true)); path condition in benchmark/functions/absolute.c: pc==0x10160(~3)
(declare-fun m4 () (_ BitVec 64)); variable for benchmark/functions/absolute.c: pc==0x1016C(~4)
(assert (= m4 (bvsub (_ bv0 64) m1))); store in benchmark/functions/absolute.c: pc==0x1016C(~4)
(declare-fun m5 () (_ BitVec 64)); variable for benchmark/functions/absolute.c: pc==0x10178(~6)
(assert (= m5 m1)); store in benchmark/functions/absolute.c: pc==0x10178(~6)

(push 1)
(assert (and (and p3 b2) (not (= (_ bv0 64) (_ bv0 64))))); exit in benchmark/functions/absolute.c: pc==0x10060(~1)
(check-sat)
(get-model)
(pop 1)

(push 1)
(assert (and (and p3 (not b2)) (not (= (_ bv0 64) (_ bv0 64))))); exit in benchmark/functions/absolute.c: pc==0x10060(~1)
(check-sat)
(get-model)
(pop 1)

(exit)